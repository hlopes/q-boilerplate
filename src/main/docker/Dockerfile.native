##
## Stage 1 — Native Build (GraalVM)
##
FROM ghcr.io/graalvm/native-image-community:21 AS native-build

WORKDIR /workspace

# Install Maven
RUN microdnf install -y maven && microdnf clean all

# Cache Maven dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -q

# Build the native executable
COPY src ./src
RUN mvn package -Pnative -DskipTests -q \
    -Dquarkus.native.container-build=false \
    -Dquarkus.native.additional-build-args="--no-fallback,--report-unsupported-elements-at-runtime"

##
## Stage 2 — Minimal runtime image (distroless / UBI micro)
##
FROM quay.io/quarkus/quarkus-micro-image:2.0

LABEL maintainer="api@example.com"
LABEL org.opencontainers.image.title="quarkus-app-native"
LABEL org.opencontainers.image.version="1.0.0"

WORKDIR /app

COPY --from=native-build /workspace/target/*-runner /app/application

# Non-root user
RUN chmod 550 /app/application && \
    chown 1001 /app/application

USER 1001

EXPOSE 8080

CMD ["/app/application", "-Dquarkus.http.host=0.0.0.0"]
